# StudyHive Environment Configuration
PORT=3000
SERVER_PORT=5000
REACT_APP_SOCKET_URL=http://localhost:5000
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Firebase Admin credentials (use a service account file kept outside git)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini key is read by the server only and is never sent to the browser.
GEMINI_API_KEY=

# Cloudinary credentials are required for file uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
